[Unit]
Description=HornetHunter management aggregator
Documentation=https://github.com/SensorsIot/HornetHunter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hornethunter
ExecStart=/opt/hornethunter/.venv/bin/hornethunter-management --config /etc/hornethunter/management.toml
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadOnlyPaths=/etc/hornethunter
# Track storage for fixes, if the aggregator is configured to persist them.
StateDirectory=hornethunter

[Install]
WantedBy=multi-user.target
